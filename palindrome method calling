#include<stdio.h>
void ispalindrome(int num){
    int temp=num;
    int rev=0;
    while(num!=0){
        int r=num%10;
        rev=rev*10+r;
        num=num/10;
    }
    if(rev==temp){
        printf("Palindrome");
    }
    else{
        printf("Not a palindrome");
    }
}
void main(){
    int n;
    scanf("%d",&n);
    ispalindrome(n);
}
